{
  "manifest_version": 3,
  "name": "Glance",
  "version": "1.1.0",
  "description": "Open GitHub pull request and issue screenshots in a modal instead of a new tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-github-image-modal@zen.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["lib/links.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
